{
  "name": "blog_website",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "fetch-blog": "rm -rf src/content/blog && git clone https://github.com/zhuang16384/blog src/content/blog",
    "dev": "mkdir -p src/content/blog && astro dev",
    "start": "mkdir -p src/content/blog && astro dev",
    "check": "astro check",
    "build": "pnpm fetch-blog && astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier './src/**/*' --write"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/rss": "^4.0.19",
    "astro": "^7.3.4",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "prettier": "~3.9.9",
    "prettier-plugin-astro": "^1.0.1",
    "sass": "^1.105.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.20.0 ^24.12.0",
      "onFail": "warn"
    }
  }
}
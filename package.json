{
  "name": "blog_website",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "fetch-blog": "rm -rf src/content/blog && git clone https://github.com/zhuang16384/blog src/content/blog",
    "dev": "mkdir -p src/content/blog && astro dev",
    "start": "mkdir -p src/content/blog && astro dev",
    "check": "astro check",
    "build": "pnpm fetch-blog && astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier './src/**/*' --write"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.7",
    "@astrojs/rss": "^4.0.17",
    "@picocss/pico": "^2.1.1",
    "astro": "^6.0.2",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "prettier": "~3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "sass": "^1.97.3"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.20.0 ^24.12.0",
      "onFail": "warn"
    }
  }
}
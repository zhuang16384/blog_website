---
const { path } = Astro.props;
// Trim slashes so "/blog", "/blog/" and "blog" compare equal
const currentPath = Astro.url.pathname.replace(/^\/+|\/+$/g, "");
const isCurrent = currentPath === path || currentPath.startsWith(`${path}/`);
---

<a href={`/${path}`} aria-current={isCurrent ? "page" : undefined}>
  <slot />
</a>

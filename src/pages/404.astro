---
import Base from "@layouts/Base.astro";
---

<Base title="Page not found - 404">
  <section>
    <h1>
      <span class="marker">404</span> not found
    </h1>
    <p class="muted">The requested URL was not found.</p>
    <a href="/" class="hand">
      Go back to the home page?
    </a>
  </section>
</Base>
{/* This CSS is not strictly necessary,
 * but a centered 404 message looks nicer. */}
<style>
  section {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
</style>
